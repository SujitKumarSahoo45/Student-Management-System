<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>  <!DOCTYPE html> <html> <head> <meta charset="UTF-8"> <title>Student Management System</title> <style> *{ margin:0; padding:0; box-sizing:border-box; font-family:Arial, sans-serif; } body{ height:100vh; background:linear-gradient(135deg,#0f172a,#1e3a8a,#0b1b3a); display:flex; justify-content:center; align-items:center; } /* MAIN CONTAINER */ .container{ width:1000px; height:600px; display:flex; border-radius:18px; overflow:hidden; box-shadow:0 15px 40px rgba(0,0,0,0.7); position:relative; } /* HEADER BAR */ .header{ position:absolute; top:0; left:0; width:100%; height:60px; background:rgba(0,0,0,0.4); display:flex; justify-content:space-between; align-items:center; padding:0 20px; z-index:10; } /* LOGO */ .logo{ display:flex; align-items:center; gap:10px; color:white; font-weight:bold; font-size:18px; } .logo img{ width:35px; height:35px; } /* LOGOUT */ .logout a{ text-decoration:none; color:white; background:#ef4444; padding:8px 14px; border-radius:6px; font-weight:bold; transition:0.3s; } .logout a:hover{ background:#dc2626; } /* LEFT IMAGE */ .left{ width:45%; background:url('https://images.unsplash.com/photo-1523580846011-d3a5bc25702b?q=80&w=1200') center/cover; position:relative; } .left::after{ content:"Manage Students Easily"; position:absolute; bottom:30px; left:20px; color:white; font-size:26px; font-weight:bold; text-shadow:2px 2px 15px black; } /* RIGHT DASHBOARD */ .right{ width:55%; padding:80px 40px 40px 40px; background:rgba(255,255,255,0.05); backdrop-filter: blur(10px); color:white; } .right h1{ text-align:center; margin-bottom:30px; font-size:28px; color:#e0e7ff; } /* GRID */ .grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:20px; } /* CARDS */ .card{ background:rgba(30,58,138,0.4); border:1px solid rgba(255,255,255,0.1); padding:25px; border-radius:12px; text-align:center; transition:0.3s; cursor:pointer; } .card:hover{ transform:translateY(-6px); background:rgba(37,99,235,0.6); } .card a{ text-decoration:none; color:white; font-size:18px; font-weight:bold; } .icon{ font-size:30px; display:block; margin-bottom:10px; } </style> </head> <body> <div class="container"> <!-- HEADER --> <div class="header"> <!-- LOGO --> <div class="logo"> <img src="https://cdn-icons-png.flaticon.com/512/3135/3135755.png"> Student System </div> <!-- LOGOUT --> <div class="logout"> <a href="login.jsp">Logout</a> </div> </div> <!-- LEFT IMAGE --> <div class="left"></div> <!-- RIGHT DASHBOARD --> <div class="right"> <h1>Dashboard</h1> <div class="grid"> <div class="card"> <span class="icon">➕</span> <a href="addStudent.jsp">Add Student</a> </div> <div class="card"> <span class="icon">📋</span> <a href="viewStudents.jsp">View Students</a> </div> <div class="card"> <span class="icon">✏</span> <a href="editStudents.jsp">Edit Student</a> </div> <div class="card"> <span class="icon">❌</span> <a href="deleteStudents.jsp">Delete Student</a> </div> </div> </div> </div> </body> </html>